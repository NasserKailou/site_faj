# =============================================================================
#  FAJ Niger — Fichier d'environnement (MODÈLE)
# -----------------------------------------------------------------------------
#  Copiez ce fichier en « .env » puis renseignez les valeurs réelles.
#  ⚠️  Le fichier .env NE DOIT JAMAIS être committé (il est dans .gitignore).
#  Voir docs/PAIEMENT.md et docs/SECURITE.md pour la procédure d'activation.
# =============================================================================

# ─── Application ─────────────────────────────────────────────────────────────
APP_ENV=production                 # production | development
DEBUG_MODE=false                   # true uniquement en développement
SITE_URL=https://www.faj.ne        # URL absolue du site (sans slash final)

# ─── Identité du site (valeurs officielles par défaut si non renseignées) ────
SITE_NAME="Fonds d'Appui à la Justice"
SITE_ABBR=FAJ
SITE_SLOGAN="Le FAJ, l'assurance d'une Justice moderne"
SITE_EMAIL=contact@faj.ne
SITE_PHONE="00227 20 37 15 95 / 00227 96 13 28 15"
SITE_ADDRESS="Niamey-Niger, Quartier Koira Kano, Rue KK 46, BP : 11240"

# ─── Base de données (MySQL/MariaDB ; fallback SQLite automatique si vide) ────
DB_HOST=localhost
DB_NAME=faj_niger
DB_USER=faj_user
DB_PASS=                            # TODO: mot de passe BD (à fournir)
DB_CHARSET=utf8mb4

# ─── Sécurité ────────────────────────────────────────────────────────────────
ADMIN_SECRET=change_me_avec_une_chaine_aleatoire_longue
SESSION_TIMEOUT=3600
SESSION_COOKIE_SECURE=true          # true en HTTPS (recommandé en production)
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_TIME=900
RATE_LIMIT_WINDOW=60
RATE_LIMIT_MAX=30

# ─── Paiement (clé-en-main) ──────────────────────────────────────────────────
# PAYMENT_MODE   : sandbox | live | disabled
# PAYMENT_GATEWAY: cinetpay | stripe (passerelle par défaut si la méthode ne
#                  correspond à aucune passerelle spécifique)
# CURRENCY       : devise ISO (XOF = Franc CFA, par défaut)
PAYMENT_MODE=sandbox
PAYMENT_GATEWAY=
CURRENCY=XOF

# CinetPay — Mobile Money (Orange Money, Moov Money) & cartes, zone UEMOA
CINETPAY_API_KEY=                   # TODO: à fournir par le FAJ (compte marchand)
CINETPAY_SITE_ID=                   # TODO: à fournir par le FAJ
CINETPAY_SECRET_KEY=                # TODO: secret HMAC pour vérifier les webhooks
CINETPAY_BASE_URL=https://api-checkout.cinetpay.com/v2/payment
CINETPAY_VERIFY_URL=https://api-checkout.cinetpay.com/v2/payment/check

# Stripe — Cartes Visa / Mastercard (international), PCI-DSS SAQ-A
STRIPE_PUBLIC_KEY=                  # pk_live_... ou pk_test_... (TODO)
STRIPE_SECRET_KEY=                  # sk_live_... ou sk_test_... (TODO)
STRIPE_WEBHOOK_SECRET=              # whsec_... (TODO)

# ─── URLs de paiement (optionnel : surchargent les valeurs par défaut) ───────
RETURN_URL=
CALLBACK_URL=
WEBHOOK_SECRET=

# ─── Email (SMTP pour les reçus de dons / contacts) ──────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=noreply@faj.ne
SMTP_PASS=                          # TODO: mot de passe SMTP (à fournir)
